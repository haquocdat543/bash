{
  "image": "devcontainer:v1",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".",
    "args": {
      "BUILDKIT_PROGRESS": "plain"
    }
  },
  "containerEnv": {
    "SHELL": "/bin/bash",
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "EDITOR": "nvim",
    "TERM": "xterm-256color"
  },
  "mounts": [
    "type=bind,source=${env:HOME}/.vimrc,target=/root/.vimrc",
    "type=bind,source=${env:HOME}/.config/nvim,target=/root/.config/nvim",
    "type=bind,source=${env:HOME}/.bashrc,target=/root/.bashrc",
    "type=bind,source=${env:HOME}/bash,target=/root/bash",
    "type=volume,source=local,target=/root/.local",
    "type=volume,source=cache,target=/root/.cache",
    "type=volume,source=npm,target=/root/.npm",
    "type=volume,source=nuget,target=/root/.nuget",
    "type=volume,source=cargo,target=/root/.cargo",
    "type=volume,source=go,target=/root/go"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/prulloac/devcontainer-features/lua:1": {
      "version": "5.1.5",
      "useApt": true
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "ssh,git,git-crypt,git-remote-gcrypt,build-essential,ninja-build,gcc,g++,make,python3,luarocks,nodejs,npm,xclip,xxd,ranger,libtool,autoconf,automake,cmake,libncurses5-dev,gettext,libncurses-dev,libtinfo-dev",
      "upgradePackages": true
    },
    "ghcr.io/duduribeiro/devcontainer-features/lunarvim:0": {},
    "ghcr.io/devcontainers/features/python:1": {
      "toolsToInstall": "pynvim,conan,vyper"
    },
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/azutake/devcontainer-features/go-packages-install:0": {
      "PACKAGES": "github.com/cosmtrek/air@latest,github.com/jesseduffield/lazygit@latest,github.com/getsops/sops/v3/cmd/sops@latest"
    },
    "ghcr.io/braun-daniel/devcontainer-features/fzf:1": {},
    "ghcr.io/devcontainers/features/rust:1": {
      "components": "rust-analyzer,rust-src,rustfmt,clippy"
    },
    "ghcr.io/lee-orr/rusty-dev-containers/cargo-binstall:0": {
      "packages": "zoxide,ripgrep,fd-find,sd,exa,bat,rustowl"
    },
    "ghcr.io/devcontainers-extra/features/bash-command:1": {
      "command": "luarocks install nvim-nio && luarocks install mimetypes && luarocks install xml2lua && luarocks install fidget.nvim"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/prulloac/devcontainer-features/lua:1",
    "ghcr.io/rocker-org/devcontainer-features/apt-packages",
    "ghcr.io/devcontainers/features/docker-in-docker",
    "ghcr.io/devcontainers/features/python",
    "ghcr.io/braun-daniel/devcontainer-features/fzf",
    "ghcr.io/duduribeiro/devcontainer-features/lunarvim",
    "ghcr.io/devcontainers/features/go",
    "ghcr.io/azutake/devcontainer-features/go-packages-install",
    "ghcr.io/devcontainers/features/rust",
    "ghcr.io/lee-orr/rusty-dev-containers/cargo-binstall",
    "ghcr.io/devcontainers/features/dotnet"
  ],
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && git config --global init.defaultBranch develop",
  "remoteUser": "root"
}
